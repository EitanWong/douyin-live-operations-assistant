{
  "name": "douyin-live-operations-assistant",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests",
    "benchmark:runtime": "node --expose-gc scripts/benchmark-runtime.mjs",
    "benchmark:workspace": "node --expose-gc scripts/benchmark-workspace.mjs",
    "agent:index": "node scripts/agent-index.mjs build",
    "agent:check": "node scripts/agent-index.mjs check",
    "agent:find": "node scripts/agent-index.mjs find",
    "agent:impact": "node scripts/agent-index.mjs impact",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/serve.mjs",
    "native:install": "node scripts/install-native.mjs",
    "native:doctor": "node scripts/install-native.mjs --doctor",
    "native:status": "node scripts/install-native.mjs --status",
    "data:install": "node scripts/install-data-native.mjs",
    "data:status": "python3 native/data_host.py status",
    "test:native": "python3 -m unittest discover -s native",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "eval:agent": "node scripts/evals/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mozilla/readability": "0.6.0",
    "@radix-ui/colors": "3.0.0",
    "@ricky0123/vad-web": "0.0.31",
    "@tanstack/react-table": "9.3.1",
    "cockatiel": "4.0.0",
    "cordis": "4.0.0-rc.12",
    "dexie": "4.4.7",
    "echarts": "^6.1.0",
    "eventsource-parser": "3.0.6",
    "hls.js": "1.7.4",
    "jsonrepair": "^3.15.0",
    "linkedom": "0.18.15",
    "lru-cache": "11.5.3",
    "minisearch": "7.2.0",
    "motion": "14.9.0",
    "mpegts.js": "1.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  }
}
